{
  "name": "grand-canyon-trail-maps",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "test:browser": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache playwright test",
    "test:unit": "node --test tests/labels/*.test.js",
    "audit": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache node scripts/audit-map.mjs",
    "build:labels": "node scripts/build-labels.mjs",
    "build:maps": "bash pipeline/build_maps.sh",
    "print:map": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache node scripts/print-map.mjs",
    "generate:map": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache node scripts/generate-map.mjs",
    "browsers:install": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache playwright install",
    "verify:maps": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache node scripts/verify-maps.mjs",
    "promote:maps": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache node scripts/verify-maps.mjs --promote",
    "layout:static": "PLAYWRIGHT_BROWSERS_PATH=.browser-cache node scripts/finalize-static.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.55.1",
    "esbuild": "0.28.2"
  }
}
